{
  "name": "palette-masters",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Palette masters: Wikimedia-powered painting explorer with 6 color extraction presets and 3 CSS variable templates",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "tsc --noEmit false --outDir .cache/tests && node --test tests/*.test.mjs",
    "cache:art": "tsc -p tsconfig.cache.json && node scripts/cache-featured.mjs && npm run build",
    "dev": "vite",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"scripts/**/*.mjs\" index.html vite.config.ts package.json \"tsconfig*.json\" .prettierrc.json \"tests/**/*.mjs\" playwright.config.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"scripts/**/*.mjs\" index.html vite.config.ts package.json \"tsconfig*.json\" .prettierrc.json \"tests/**/*.mjs\" playwright.config.mjs",
    "test:browser": "playwright test",
    "benchmark:pipeline": "tsc --noEmit false --outDir .cache/tests && node --expose-gc scripts/benchmark-pipeline.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide": "^1.63.0"
  }
}
